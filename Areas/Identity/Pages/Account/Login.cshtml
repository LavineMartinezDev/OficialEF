@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar Sessão";
}

<style>
    /* Container Principal Horizontal */
    .split-page-container {
        display: flex;
        width: 100%;
        min-height: 550px;
        background-color: #FFFFF0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        margin: 2rem 0;
    }

    /* Lado Esquerdo: Formulário */
    .form-section {
        width: 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        background-color: #FFFFF0;
    }

    .form-wrapper {
        width: 100%;
        max-width: 380px;
    }

    .brand-title {
        font-family: Georgia, serif;
        font-size: 35px;
        font-weight: bold;
        color: #2C82B5;
        margin-bottom: 5px;
        text-align: center;
    }

    .subtitle {
        font-size: 15px;
        color: #555555;
        text-align: center;
        margin-bottom: 30px;
    }

    /* Campos de Input */
    .form-floating > .form-control {
        background-color: #BCE5FF;
        border: 1px solid transparent;
        border-radius: 12px;
        color: #1a2a3a;
    }

    .form-floating > .form-control:focus {
        background-color: #d4efff;
        border-color: #2C82B5;
        box-shadow: 0 0 0 0.25rem rgba(44, 130, 181, 0.25);
    }

    .form-floating > label {
        color: #4a6b82;
    }

    /* Checkbox "Remember me" */
    .form-check {
        margin: 15px 0;
    }

    .form-check-input:checked {
        background-color: #2C82B5;
        border-color: #2C82B5;
    }

    /* Botão Principal */
    .btn-custom-primary {
        background-color: #2C82B5;
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        width: 100%;
        transition: background-color 0.2s;
    }

    .btn-custom-primary:hover {
        background-color: #21648d;
        color: #ffffff;
    }

    /* Links de Ajuda / Registo */
    .extra-links {
        margin-top: 20px;
        text-align: center;
        font-size: 14px;
    }

    .extra-links a {
        color: #2C82B5;
        text-decoration: none;
        font-weight: 500;
        display: block;
        margin-top: 8px;
    }

    .extra-links a:hover {
        text-decoration: underline;
    }

    /* Lado Direito: Espaço para Imagem */
    .image-section {
        width: 50%;
        background-color: #BCE5FF;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .image-section img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>

<div class="split-page-container">
    <!-- Seção do Formulário (Lado Esquerdo) -->
    <div class="form-section">
        <div class="form-wrapper">
            <h1 class="brand-title">Flores & Arte</h1>
            <p class="subtitle">Bem-vindo de volta! Faça login na sua conta.</p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                    <label asp-for="Input.Email">E-mail</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Palavra-passe" />
                    <label asp-for="Input.Password">Palavra-passe</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">
                        Lembrar-me?
                    </label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-custom-primary mt-2">Iniciar Sessão</button>
            </form>

            <div class="extra-links">
                <p id="forgot-password" class="mb-1">
                    <a id="forgot-password" asp-page="./ForgotPassword">Esqueceu-se da sua palavra-passe?</a>
                </p>
                <p class="mb-1">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Criar uma nova conta</a>
                </p>
                <p>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Reenviar confirmação por e-mail</a>
                </p>
            </div>
        </div>
    </div>

    <!-- Seção da Imagem (Lado Direito) -->
    <div class="image-section">
        <!-- Substitua pelo caminho da sua imagem de flores -->
        <img src="~/images/sua-imagem-de-flores.jpg" alt="Ilustração de Flores" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}