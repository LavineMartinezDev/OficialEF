@page
@model RegisterModel

@{
    ViewData["Title"] = "Criar Conta";
}

<style>
    /* Container Principal Horizontal */
    .split-page-container {
        display: flex;
        width: 100%;
        min-height: 550px;
        background-color: #FFFFF0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        margin: 2rem 0;
    }

    /* Lado Esquerdo: Formulário */
    .form-section {
        width: 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        background-color: #FFFFF0;
    }

    .form-wrapper {
        width: 100%;
        max-width: 380px;
    }

    .brand-title {
        font-family: Georgia, serif;
        font-size: 35px;
        font-weight: bold;
        color: #2C82B5;
        margin-bottom: 5px;
        text-align: center;
    }

    .subtitle {
        font-size: 15px;
        color: #555555;
        text-align: center;
        margin-bottom: 30px;
    }

    /* Campos de Input */
    .form-floating > .form-control {
        background-color: #BCE5FF;
        border: 1px solid transparent;
        border-radius: 12px;
        color: #1a2a3a;
    }

    .form-floating > .form-control:focus {
        background-color: #d4efff;
        border-color: #2C82B5;
        box-shadow: 0 0 0 0.25rem rgba(44, 130, 181, 0.25);
    }

    .form-floating > label {
        color: #4a6b82;
    }

    /* Botão Principal */
    .btn-custom-primary {
        background-color: #2C82B5;
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        width: 100%;
        transition: background-color 0.2s;
    }

    .btn-custom-primary:hover {
        background-color: #21648d;
        color: #ffffff;
    }

    /* Divisor */
    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 20px 0;
        color: #888888;
        font-size: 14px;
    }

    .divider span {
        width: 100%;
        border-bottom: 1px solid #cccccc;
        line-height: 0.1em;
        margin: 10px 0;
    }

    .divider span span {
        background: #FFFFF0;
        padding: 0 10px;
    }

    /* Botões Externos */
    .btn-external {
        background-color: transparent;
        border: 1px solid #2C82B5;
        color: #2C82B5;
        border-radius: 12px;
        padding: 10px;
        font-weight: 500;
        width: 100%;
        margin-bottom: 8px;
    }

    .btn-external:hover {
        background-color: #BCE5FF;
        color: #2C82B5;
    }

    .login-link {
        text-align: center;
        margin-top: 25px;
        font-size: 14px;
    }

    .login-link a {
        color: #2C82B5;
        text-decoration: none;
        font-weight: bold;
    }

    .login-link a:hover {
        text-decoration: underline;
    }

    /* Lado Direito: Espaço para Imagem */
    .image-section {
        width: 50%;
        background-color: #BCE5FF;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .image-section img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>

<div class="split-page-container">
    <!-- Seção do Formulário (Lado Esquerdo) -->
    <div class="form-section">
        <div class="form-wrapper">
            <h1 class="brand-title">Flores & Arte</h1>
            <p class="subtitle">Crie a sua conta para começar</p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                    <label asp-for="Input.Email">E-mail</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Palavra-passe" />
                    <label asp-for="Input.Password">Palavra-passe</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmar palavra-passe" />
                    <label asp-for="Input.ConfirmPassword">Confirmar Palavra-passe</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button id="registerSubmit" type="submit" class="btn btn-custom-primary mt-2">Registar</button>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="divider">
                    <span><span>ou registar com</span></span>
                </div>

                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn btn-external" name="provider" value="@provider.Name" title="Registar com a conta @provider.DisplayName">
                            @provider.DisplayName
                        </button>
                    }
                </form>
            }

            <div class="login-link">
                Já tem uma conta? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Iniciar sessão</a>
            </div>
        </div>
    </div>

    <!-- Seção da Imagem (Lado Direito) -->
    <div class="image-section">
        <!-- Substitua pelo caminho da sua imagem -->
        <img src="~/images/sua-imagem-de-flores.jpg" alt="Ilustração de Flores" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}